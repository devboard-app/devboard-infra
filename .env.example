POSTGRES_USER=devboard_admin
POSTGRES_PASSWORD=your_postgres_password

MONGO_ROOT_USER=devboard_admin
MONGO_ROOT_PASSWORD=your_mongo_root_password

MINIO_ROOT_USER=devboard_admin
MINIO_ROOT_PASSWORD=your_minio_root_password

# Service DB passwords. Passed to the postgres container and consumed by
# init-db/01-init.sh the first time Postgres initialises an empty volume.
# Each MUST match the password in that service's own .env / DATABASE_URL.
AUTH_DB_PASSWORD=your_auth_password
CORE_DB_PASSWORD=your_core_password
WORK_DB_PASSWORD=your_work_password
INTEGRATIONS_DB_PASSWORD=your_integrations_password
ATTACHMENTS_DB_PASSWORD=your_attachments_password
